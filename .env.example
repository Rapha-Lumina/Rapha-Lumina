# MySQL Database Configuration (for cPanel/Spaceship hosting)
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_cpanel_username_rapha
DB_PASSWORD=your_database_password
DB_NAME=your_cpanel_username_rapha_lumina

# Application Settings
NODE_ENV=production
PORT=3000

# Session Secret (generate a random string)
SESSION_SECRET=your-secret-key-here

# Anthropic API Key (for AI chat functionality)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional: ElevenLabs API Key (for voice features)
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# Optional: Stripe Keys (for payments)
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
